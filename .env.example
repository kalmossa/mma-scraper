# --- Database ---------------------------------------------------------------
# Set USE_SUPABASE=True to target a hosted PostgreSQL (Supabase or any other),
# otherwise the local PostgreSQL below is used.
USE_SUPABASE=False

# Local PostgreSQL
DB_NAME=mma_scraper
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Hosted PostgreSQL (e.g. Supabase connection pooler)
SUPABASE_DB=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=
SUPABASE_HOST=
SUPABASE_PORT=5432

# --- Scraping behaviour (optional, can also be exported in the shell) -------
# Route Tapology through a real Chrome window (recommended, see README)
# SCRAPER_SELENIUM=1
# SCRAPER_SELENIUM_HEADLESS=0
# Route every HTTP request through a proxy
# SCRAPER_PROXY=socks5://127.0.0.1:9050
# Dump the raw HTML of fetched pages (debugging)
# SCRAPER_DUMP_HTML=0
